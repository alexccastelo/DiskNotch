<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Extensões de widget precisam rodar em sandbox. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Leitura do histórico gravado pelo app (SQLite em modo WAL também precisa escrever o -shm). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/DiskNotch/</string>
    </array>
    <!-- Leitura dos limites de alerta escolhidos no app. -->
    <key>com.apple.security.temporary-exception.shared-preference.read-only</key>
    <array>
        <string>id.nexum.disknotch</string>
    </array>
</dict>
</plist>
